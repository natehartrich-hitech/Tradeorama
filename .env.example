# Copy to .env and fill in. NEVER commit .env.

# Private key of the wallet that signs orders (hex, with or without 0x).
# Leave empty to run in read-only mode (browse markets, no trading).
POLY_PRIVATE_KEY=

# Signature type:
#   0 = plain EOA wallet (MetaMask etc. trading directly from the key's address)
#   1 = Polymarket email / Magic wallet (key exported from polymarket.com)
#   2 = Browser-wallet proxy (Polymarket account created via MetaMask etc.)
POLY_SIGNATURE_TYPE=1

# Address that holds your funds. For types 1 and 2 this is the proxy address
# shown on your Polymarket profile; for type 0 leave empty (uses the key's address).
POLY_FUNDER_ADDRESS=

# Optional: pre-generated L2 API credentials. If empty they are derived from the key.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Safety. DRY_RUN=true signs nothing and sends nothing; orders are only validated and echoed.
DRY_RUN=true
# Reject any single order whose notional (price * size, in USDC) exceeds this.
MAX_ORDER_USD=50

# ---- Automated sports strategy (python -m tradeorama.strategy) ----
# Pinnacle odds come from The Odds API: https://the-odds-api.com (free tier: 500 requests/month).
ODDS_API_KEY=
# Comma-separated The Odds API sport keys, e.g. basketball_nba,icehockey_nhl,soccer_epl
STRATEGY_SPORTS=basketball_nba
# Money set aside for the bot; bet sizes are a fraction of this.
BANKROLL_USD=200
# Fraction of full Kelly to bet. 0.25 = quarter Kelly.
KELLY_MULTIPLIER=0.25
# Minimum expected profit per share after fees, in dollars (0.03 = 3 cents).
MIN_EDGE=0.03
# Most the bot will put on any one game.
MAX_GAME_EXPOSURE_USD=25
# Most the bot will spend per UTC day.
MAX_DAILY_SPEND_USD=100
# Ignore Pinnacle prices older than this.
MAX_ODDS_AGE_SEC=300
# Stop trading a game this many minutes before it starts.
MIN_MINUTES_BEFORE_START=5
# If Polymarket's midpoint is further than this from Pinnacle, assume the match is wrong and skip it.
MAX_DIVERGENCE=0.15
# Polymarket taker fee rate. Fee per share = TAKER_FEE_RATE * price * (1 - price),
# e.g. 0.05 * 0.40 * 0.60 = 1.2 cents at 40 cents. 0.05 is Polymarket's Sports rate;
# if it changes, the current table is at https://docs.polymarket.com/trading/fees
# (makers pay no fee, but this bot only takes liquidity).
TAKER_FEE_RATE=0.05
# Where trades are recorded.
STRATEGY_DB=tradeorama.db
# Odds polling schedule (saves Odds API credits). The bot checks every --interval seconds
# (default 300) within POLL_NEAR_HOURS of a sport's next game, every POLL_MID_SEC within
# POLL_MID_HOURS, every POLL_FAR_SEC further out, and every POLL_IDLE_SEC when no games are listed.
POLL_NEAR_HOURS=2
POLL_MID_HOURS=12
POLL_MID_SEC=900
POLL_FAR_SEC=3600
POLL_IDLE_SEC=21600
